{
  "name": "personal-workbench",
  "version": "0.1.0",
  "description": "本地优先的个人创作工作台",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "npm run build && playwright test && playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "dockview-react": "8.9.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
