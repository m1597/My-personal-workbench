{
  "manifestVersion": 1,
  "id": "io.fitbay.prompts",
  "version": "0.2.7",
  "protocol": "0.1",
  "hostApi": "0.1",
  "name": "提示词库",
  "uiEntry": "index.html",
  "capabilities": ["view.transfer"],
  "modes": ["standalone", "docked"],
  "settingsEntries": [
    {
      "target": "directory",
      "name": "目录",
      "path": "提示词库 → 目录"
    },
    {
      "target": "shortcut",
      "name": "全局快捷键",
      "path": "提示词库 → 全局快捷键"
    },
    {
      "target": "api",
      "name": "API 与模型",
      "path": "提示词库 → API 与模型"
    }
  ]
}
